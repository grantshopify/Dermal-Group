{% doc %}
  @prompt
    MOVING ANNOUNCEMENT BAR, MAKE IT full with please and colour editable etc, font editable , i dont think its full page width?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-moving-announcement-{{ ai_gen_id }} { display:block; position:relative; left:50%; width:100vw; max-width:100vw; margin-left:-50vw; overflow:hidden; background-color:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; }
  .ai-moving-announcement-{{ ai_gen_id }}__track { display:flex; width:100%; overflow:hidden; white-space:nowrap; }
  .ai-moving-announcement-{{ ai_gen_id }}__content { display:flex; flex:0 0 auto; align-items:center; gap:{{ block.settings.gap }}px; padding:{{ block.settings.bar_padding }}px {{ block.settings.gap }}px; font-family:{{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }}; font-style:{{ block.settings.text_font.style }}; font-weight:{{ block.settings.text_font.weight }}; font-size:{{ block.settings.text_size }}px; line-height:1.4; letter-spacing:.02em; animation:ai-moving-announcement-scroll-{{ ai_gen_id }} {{ block.settings.duration }}s linear infinite; }
  .ai-moving-announcement-{{ ai_gen_id }}__item { display:inline-flex; align-items:center; gap:{{ block.settings.gap }}px; }
  .ai-moving-announcement-{{ ai_gen_id }}__separator { color:{{ block.settings.accent_color }}; font-size:1.15em; line-height:1; flex-shrink:0; }
  .ai-moving-announcement-{{ ai_gen_id }}__link { color:inherit; text-decoration:underline; text-underline-offset:3px; }
  .ai-moving-announcement-{{ ai_gen_id }}__link:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  .ai-moving-announcement-{{ ai_gen_id }}:hover .ai-moving-announcement-{{ ai_gen_id }}__content, .ai-moving-announcement-{{ ai_gen_id }}:focus-within .ai-moving-announcement-{{ ai_gen_id }}__content { animation-play-state:paused; }
  @keyframes ai-moving-announcement-scroll-{{ ai_gen_id }} { from { transform:translateX(0); } to { transform:translateX(-50%); } }
  @media (prefers-reduced-motion:reduce) { .ai-moving-announcement-{{ ai_gen_id }}__track { overflow-x:auto; scrollbar-width:thin; } .ai-moving-announcement-{{ ai_gen_id }}__content { animation:none; } }
  @media screen and (max-width:749px) { .ai-moving-announcement-{{ ai_gen_id }}__content { font-size:{{ block.settings.mobile_text_size }}px; } }
{% endstyle %}
<div class="ai-moving-announcement-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-moving-announcement-{{ ai_gen_id }}__track" role="region" aria-label="{{ block.settings.announcement | escape }}">
    <div class="ai-moving-announcement-{{ ai_gen_id }}__content" aria-hidden="true">
      {% for copy in (1..2) %}<span class="ai-moving-announcement-{{ ai_gen_id }}__item">{% if block.settings.announcement_link != blank %}<a class="ai-moving-announcement-{{ ai_gen_id }}__link" href="{{ block.settings.announcement_link }}" tabindex="-1">{{ block.settings.announcement }}</a>{% else %}<span>{{ block.settings.announcement }}</span>{% endif %}<span class="ai-moving-announcement-{{ ai_gen_id }}__separator" aria-hidden="true">{{ block.settings.separator }}</span></span>{% endfor %}
    </div>
    <span class="visually-hidden">{{ block.settings.announcement }}</span>
  </div>
</div>
{% schema %}
{
  "name": "Moving announcement",
  "settings": [
    { "type": "header", "content": "Announcement" },
    { "type": "text", "id": "announcement", "label": "Message", "default": "Discover your best skin with Dermal Group" },
    { "type": "url", "id": "announcement_link", "label": "Message link" },
    { "type": "text", "id": "separator", "label": "Separator symbol", "default": "✦" },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "text_font", "label": "Font", "default": "inter_n4" },
    { "type": "range", "id": "text_size", "label": "Desktop text size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_text_size", "label": "Mobile text size", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Separator", "default": "#CCEFF6" },
    { "type": "range", "id": "bar_padding", "label": "Bar height padding", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "gap", "label": "Item spacing", "min": 12, "max": 60, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "duration", "label": "Scroll duration", "min": 10, "max": 60, "step": 5, "unit": "s", "default": 30 }
  ],
  "presets": [{ "name": "Moving announcement" }],
  "tag": null,
  "class": "moving-announcement-block"
}
{% endschema %}