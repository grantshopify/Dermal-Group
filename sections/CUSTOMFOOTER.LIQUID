{% liquid
  assign s = section.settings
  assign social_links = 'facebook_url,instagram_url,youtube_url,tiktok_url,twitter_url,linkedin_url' | split: ','
  assign whatsapp_number = settings.dg_whatsapp_number | strip | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
%}
<footer class="footer-custom" style="--footer-bg:{{ s.background_color }};--footer-content-width:{{ s.content_width }}px;--footer-heading-color:{{ s.heading_color }};--footer-link-color:{{ s.link_color }};--footer-body-color:{{ s.body_color }};--footer-heading-size:{{ s.heading_size }}px;--footer-link-size:{{ s.link_size }}px;--footer-body-size:{{ s.body_size }}px;" {{ section.shopify_attributes }}>
  <div class="footer-custom__inner">
    <div class="footer-custom__services">
      <div><span class="footer-custom__service-icon" aria-hidden="true">↗</span><p><strong>{{ 'modern_footer.delivery' | t }}</strong><span>{{ 'modern_footer.cutoff' | t }}</span></p></div>
      <div><span class="footer-custom__service-icon" aria-hidden="true">↶</span><p><strong>{{ 'modern_footer.returns' | t }}</strong><span>{{ 'modern_footer.returns_detail' | t }}</span></p></div>
      <div><span class="footer-custom__service-icon" aria-hidden="true">?</span><p><strong>{{ 'modern_footer.support' | t }}</strong><span>{{ 'modern_footer.support_detail' | t }}</span></p></div>
    </div>
    <div class="footer-custom__columns">
      <div class="footer-custom__brand">
        <a class="footer-custom__wordmark" href="{{ routes.root_url }}">{{ s.brand_heading | escape }}<span aria-hidden="true">.</span></a>
        <p>{{ s.brand_description | escape }}</p>
        <span class="footer-custom__professional">{{ 'modern_footer.professional' | t }}</span>
      </div>
      {% for block in section.blocks %}
        <section class="footer-custom__column footer-custom__column--{{ block.type }}" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
          {% if block.type == 'menu' %}
            <nav aria-label="{{ block.settings.heading | escape }}"><ul>
              {% if block.settings.menu != blank %}
                {% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}
              {% elsif block.settings.fallback == 'shop' %}
                <li><a href="{{ routes.all_products_collection_url }}">{{ 'modern_footer.all_products' | t }}</a></li>
                {% for collection in collections limit: 6 %}{% unless collection.handle == 'all' or collection.handle == 'frontpage' %}<li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>{% endunless %}{% endfor %}
              {% else %}
                {% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}
                {% if pages['faq'] != blank %}<li><a href="{{ pages['faq'].url }}">{{ 'modern_footer.faqs' | t }}</a></li>{% elsif pages['faqs'] != blank %}<li><a href="{{ pages['faqs'].url }}">{{ 'modern_footer.faqs' | t }}</a></li>{% endif %}
                {% if shop.customer_accounts_enabled %}<li><a href="{{ routes.account_url }}">{{ 'modern_footer.account' | t }}</a></li>{% endif %}
                {% if pages['contact'] != blank %}<li><a href="{{ pages['contact'].url }}">{{ 'modern_footer.contact' | t }}</a></li>{% endif %}
                {% if s.email != blank %}<li><a href="mailto:{{ s.email | escape }}">{{ 'modern_footer.order_help' | t }}</a></li>{% endif %}
              {% endif %}
            </ul></nav>
          {% endif %}
          {% if block.settings.content != blank %}<div class="footer-custom__column-content">{{ block.settings.content }}</div>{% endif %}
          {% if block.type == 'contact' %}
            <div class="footer-custom__contact">
              {% if s.email != blank %}<a class="footer-custom__email" href="mailto:{{ s.email | escape }}">{{ s.email | escape }}</a>{% endif %}
              {% if s.phone != blank %}<a href="tel:{{ s.phone | remove: ' ' | escape }}">{{ s.phone | escape }}</a>{% endif %}
              {% if settings.dg_whatsapp_enabled and whatsapp_number != blank %}<a href="https://wa.me/{{ whatsapp_number | escape }}" target="_blank" rel="noopener noreferrer">{{ 'modern_footer.whatsapp' | t }} ↗</a>{% endif %}
              <p>{{ 'modern_footer.order_number' | t }}</p>
            </div>
            <div class="footer-custom__socials" aria-label="{{ 'modern_footer.social' | t }}">
              {% for link_key in social_links %}{% assign link_url = s[link_key] %}{% if link_url != blank %}{% assign platform = link_key | remove: '_url' %}<a href="{{ link_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ platform | capitalize }}"><svg aria-hidden="true" viewBox="0 0 20 20">{% render 'icon', icon: platform %}</svg></a>{% endif %}{% endfor %}
            </div>
          {% endif %}
        </section>
      {% endfor %}
    </div>
    <div class="footer-custom__notice"><p>{{ 'modern_footer.notice' | t }}</p>{% if s.registration_text != blank %}<div>{{ s.registration_text }}</div>{% endif %}</div>
    <div class="footer-custom__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ s.brand_heading | escape }}. {{ 'modern_footer.rights' | t }}</p>
      {% if shop.enabled_payment_types != empty %}<ul class="footer-custom__payments" aria-label="{{ 'modern_footer.payments' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</footer>
{% stylesheet %}
.footer-custom{width:100%;padding:0 32px 24px;background:var(--footer-bg,#111c2e);color:var(--footer-body-color,#bdc8d8);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-style:normal;font-weight:400;letter-spacing:0;line-height:1.6}
.footer-custom *{box-sizing:border-box}.footer-custom__inner{max-width:var(--footer-content-width,1200px);margin:auto}.footer-custom p{margin:0}.footer-custom a{color:var(--footer-link-color,#d3dce8);text-decoration:none;transition:color .15s ease}.footer-custom a:hover{color:#75e1db}.footer-custom a:focus-visible{outline:2px solid #75e1db;outline-offset:5px;border-radius:2px}
.footer-custom__services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding:30px 0;border-bottom:1px solid #ffffff21}.footer-custom__services>div{display:flex;align-items:center;gap:14px}.footer-custom__service-icon{display:grid;place-items:center;flex:none;width:40px;height:40px;border:1px solid #75e1db55;border-radius:12px;color:#75e1db;font-size:24px;line-height:1}.footer-custom__services strong,.footer-custom__services p>span{display:block}.footer-custom__services strong{color:#fff;font-size:14px;font-weight:600}.footer-custom__services p>span{font-size:12px;margin-top:2px;color:#b7c4d6}
.footer-custom__columns{display:grid;grid-template-columns:1.3fr .85fr 1fr 1.2fr;gap:48px;padding:48px 0 36px}.footer-custom__brand,.footer-custom__column{min-width:0}.footer-custom a.footer-custom__wordmark{display:inline-block;color:#fff;font-size:30px;font-weight:650;line-height:1.15;letter-spacing:-1.2px}.footer-custom__wordmark>span{color:#75e1db}.footer-custom__brand>p{max-width:280px;margin-top:18px;font-size:14px;line-height:1.8;color:var(--footer-body-color)}.footer-custom__professional{display:inline-flex;margin-top:22px;padding:5px 10px;border:1px solid #ffffff25;border-radius:6px;font-size:11px;font-weight:500;letter-spacing:.4px;color:#d0dbe9}
.footer-custom h2{margin:0 0 18px;color:var(--footer-heading-color,#fff);font-family:inherit;font-size:var(--footer-heading-size,15px);font-weight:600;line-height:1.4;letter-spacing:0;text-transform:none}.footer-custom ul{list-style:none;padding:0;margin:0}.footer-custom nav li+li{margin-top:10px}.footer-custom nav a,.footer-custom__contact>a{display:inline-block;font-size:var(--footer-link-size,14px);font-weight:400;line-height:1.7}.footer-custom__contact{display:flex;flex-direction:column;align-items:flex-start;gap:9px}.footer-custom__contact>a{overflow-wrap:anywhere}.footer-custom__column-content,.footer-custom__contact p{font-size:var(--footer-body-size,14px);color:var(--footer-body-color);line-height:1.75}.footer-custom__column-content{margin-bottom:12px}.footer-custom__contact p{margin-top:8px;font-size:12px}.footer-custom__socials{display:flex;gap:12px;margin-top:18px}.footer-custom__socials a{display:grid;place-items:center;width:32px;height:32px;border:1px solid #ffffff26;border-radius:50%}.footer-custom__socials svg{width:16px;height:16px;fill:currentColor}
.footer-custom__notice{padding:20px 0;border-top:1px solid #ffffff21;font-size:11px;color:#a5b4c9;line-height:1.7}.footer-custom__notice>div{margin-top:8px}.footer-custom__bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:18px;border-top:1px solid #ffffff21;font-size:11px;color:#a5b4c9}.footer-custom ul.footer-custom__payments{display:flex;flex-wrap:wrap;align-items:center;gap:6px}.footer-custom__payments svg{display:block;width:34px;height:22px}
@media(max-width:1000px){.footer-custom__columns{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.footer-custom__services{gap:15px}.footer-custom__services strong{font-size:13px}}
@media(max-width:600px){.footer-custom{padding:0 22px 24px}.footer-custom__services{grid-template-columns:1fr;padding:24px 0;gap:18px}.footer-custom__columns{gap:30px 22px;padding:32px 0 28px}.footer-custom__brand,.footer-custom__column--contact{grid-column:1/-1}.footer-custom__brand>p{max-width:100%;margin-top:12px}.footer-custom__professional{margin-top:15px}.footer-custom a.footer-custom__wordmark{font-size:28px}.footer-custom h2{margin-bottom:14px}.footer-custom nav a{min-height:30px}.footer-custom nav li+li{margin-top:4px}.footer-custom__column--contact{padding-top:22px;border-top:1px solid #ffffff21}.footer-custom__bottom{flex-direction:column;align-items:flex-start;gap:14px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Custom footer",
  "tag": "section",
  "class": "footer-custom-section",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Important info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Column menu"
        },
        {
          "type": "select",
          "id": "desktop_width",
          "label": "Desktop column width",
          "options": [
            {
              "value": "1",
              "label": "1 column"
            },
            {
              "value": "2",
              "label": "2 columns"
            },
            {
              "value": "3",
              "label": "3 columns"
            },
            {
              "value": "4",
              "label": "4 columns"
            }
          ],
          "default": "1"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Links when no menu selected",
          "options": [
            {
              "value": "shop",
              "label": "Product categories"
            },
            {
              "value": "help",
              "label": "Customer information"
            }
          ],
          "default": "help"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact and social",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Contact info"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Column text"
        },
        {
          "type": "select",
          "id": "desktop_width",
          "label": "Desktop column width",
          "options": [
            {
              "value": "1",
              "label": "1 column"
            },
            {
              "value": "2",
              "label": "2 columns"
            },
            {
              "value": "3",
              "label": "3 columns"
            },
            {
              "value": "4",
              "label": "4 columns"
            }
          ],
          "default": "1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Terms and conditions"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Column text"
        },
        {
          "type": "select",
          "id": "desktop_width",
          "label": "Desktop column width",
          "options": [
            {
              "value": "1",
              "label": "1 column"
            },
            {
              "value": "2",
              "label": "2 columns"
            },
            {
              "value": "3",
              "label": "3 columns"
            },
            {
              "value": "4",
              "label": "4 columns"
            }
          ],
          "default": "2"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Footer width",
      "options": [
        {
          "value": "theme-width",
          "label": "Theme width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop footer columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "stack",
          "label": "Stacked"
        },
        {
          "value": "accordion",
          "label": "Stacked with dividers"
        }
      ],
      "default": "accordion"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Outer border color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Outer border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Desktop inline padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_inline",
      "label": "Mobile inline padding",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "012345 322142"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "support@mail.com"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X/Twitter URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "<p>\u00a9 Copyright 2026. All rights reserved.</p>"
    },
    {
      "type": "richtext",
      "id": "registration_text",
      "label": "Registration text",
      "default": "<p>Company registration and pharmacist information.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading font weight",
      "min": 300,
      "max": 800,
      "step": 100,
      "default": 700
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "link_weight",
      "label": "Link font weight",
      "min": 300,
      "max": 800,
      "step": 100,
      "default": 500
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "social_color",
      "label": "Social icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "social_size",
      "label": "Social icon size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Brand name",
      "default": "Dermal Group"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand introduction",
      "default": "Aesthetic supplies for professionals. Explore dermal fillers, skin boosters and clinic essentials in one place."
    }
  ],
  "presets": [
    {
      "name": "Custom footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Important info"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Our websites"
          }
        },
        {
          "type": "contact",
          "settings": {
            "heading": "Contact info"
          }
        },
        {
          "type": "text",
          "settings": {
            "heading": "Terms and conditions",
            "desktop_width": "2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
