      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>

{%- comment -%}
  SShop typography controls - added automatically when the section is installed.
{%- endcomment -%}
{%- liquid
  assign sshop_font_source = section.settings.sshop_font_source | default: 'theme'
  assign sshop_body_font = ''
  assign sshop_heading_font = ''

  if sshop_font_source == 'custom'
    assign sshop_body_font = section.settings.sshop_body_font
    assign sshop_heading_font = section.settings.sshop_heading_font
  elsif sshop_font_source == 'theme'
    assign sshop_body_font = settings.type_body_font | default: settings.body_font | default: settings.font_body | default: settings.base_font
    assign sshop_heading_font = settings.type_header_font | default: settings.type_heading_font | default: settings.heading_font | default: settings.font_heading
  endif

  if sshop_heading_font == blank
    assign sshop_heading_font = sshop_body_font
  endif
-%}
{%- if sshop_body_font != blank -%}
  {%- liquid
    assign sshop_body_bold = sshop_body_font | font_modify: 'weight', 'bolder'
    assign sshop_body_italic = sshop_body_font | font_modify: 'style', 'italic'
    assign sshop_body_bold_italic = sshop_body_bold | font_modify: 'style', 'italic'
    assign sshop_heading_bold = sshop_heading_font | font_modify: 'weight', 'bolder'
  -%}
  <style data-sshop-typography="{{ section.id }}">
    {{ sshop_body_font | font_face: font_display: 'swap' }}
    {{ sshop_body_bold | font_face: font_display: 'swap' }}
    {{ sshop_body_italic | font_face: font_display: 'swap' }}
    {{ sshop_body_bold_italic | font_face: font_display: 'swap' }}
    {{ sshop_heading_font | font_face: font_display: 'swap' }}
    {{ sshop_heading_bold | font_face: font_display: 'swap' }}

    #shopify-section-{{ section.id }} {
      --sshop-font-body: {{ sshop_body_font.family }}, {{ sshop_body_font.fallback_families }};
      --sshop-font-heading: {{ sshop_heading_font.family }}, {{ sshop_heading_font.fallback_families }};
    }

    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :where(
      p, a, span:not([class*="icon"]), li, dt, dd, td, th, caption,
      label, legend, figcaption, blockquote, cite, q, small, strong, b,
      em, u, mark, address, time, output, summary, details,
      div:not([class*="icon"]), button, input, select, textarea, option
    ) {
      font-family: var(--sshop-font-body) !important;
    }

    #shopify-section-{{ section.id }} :where(h1, h2, h3, h4, h5, h6) {
      font-family: var(--sshop-font-heading) !important;
    }

    {%- comment -%}
      A word picked out inside a heading is an em, a strong or a span, which
      the body rule above also names — at the same specificity. Without this
      rule, placed after it, the accent word switched to the body font.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} :where(h1, h2, h3, h4, h5, h6) :where(*:not([class*="icon"])) {
      font-family: var(--sshop-font-heading) !important;
    }
  </style>
{%- endif -%}
{% schema %}
{
  "name": "SShop:Reviews Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "5-Star Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Loved by Thousands"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join thousands of happy customers worldwide"
    },
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width",
      "min": 280,
      "max": 450,
      "step": 10,
      "default": 360,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_second_row",
      "label": "Show Second Row",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 28,
      "max": 64,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size Mobile",
      "min": 24,
      "max": 44,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Review Text Size",
      "min": 13,
      "max": 18,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
