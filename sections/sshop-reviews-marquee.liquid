{% comment %}
  Reviews Marquee Section
  Infinite scrolling ticker-style reviews with modern design
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --rm-bg: {{ section.settings.bg_color }};
    --rm-card-bg: {{ section.settings.card_bg }};
    --rm-text: {{ section.settings.text_color }};
    --rm-heading: {{ section.settings.heading_color }};
    --rm-accent: {{ section.settings.accent_color }};
    --rm-star: {{ section.settings.star_color }};
    --rm-speed: {{ section.settings.scroll_speed }}s;
  }

  #shopify-section-{{ section.id }} * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .rm-section {
    background: var(--rm-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .rm-header {
    text-align: center;
    padding: 0 20px;
    margin-bottom: 50px;
  }

  #shopify-section-{{ section.id }} .rm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--rm-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .rm-eyebrow svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .rm-title {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    color: var(--rm-heading);
    margin-bottom: 16px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .rm-subtitle {
    font-size: 18px;
    color: var(--rm-text);
    opacity: 0.7;
    max-width: 500px;
    margin: 0 auto;
  }

  /* Marquee Container */
  #shopify-section-{{ section.id }} .rm-marquee-wrapper {
    position: relative;
    padding: 20px 0;
  }

  #shopify-section-{{ section.id }} .rm-marquee-wrapper::before,
  #shopify-section-{{ section.id }} .rm-marquee-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 150px;
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .rm-marquee-wrapper::before {
    left: 0;
    background: linear-gradient(90deg, var(--rm-bg) 0%, transparent 100%);
  }

  #shopify-section-{{ section.id }} .rm-marquee-wrapper::after {
    right: 0;
    background: linear-gradient(-90deg, var(--rm-bg) 0%, transparent 100%);
  }

  #shopify-section-{{ section.id }} .rm-track {
    display: flex;
    width: max-content;
    animation: rm-scroll-{{ section.id }} var(--rm-speed) linear infinite;
  }

  #shopify-section-{{ section.id }} .rm-track:hover {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .rm-track.reverse {
    animation-name: rm-scroll-reverse-{{ section.id }};
  }

  @keyframes rm-scroll-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes rm-scroll-reverse-{{ section.id }} {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  #shopify-section-{{ section.id }} .rm-card {
    flex-shrink: 0;
    width: {{ section.settings.card_width }}px;
    background: var(--rm-card-bg);
    border-radius: {{ section.settings.border_radius }}px;
    padding: 28px;
    margin: 0 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    border: 1px solid rgba(0,0,0,0.05);
  }

  #shopify-section-{{ section.id }} .rm-card:hover {
    transform: scale(1.03);
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .rm-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .rm-stars {
    display: flex;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .rm-stars svg {
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .rm-stars .filled { fill: var(--rm-star); }
  #shopify-section-{{ section.id }} .rm-stars .empty { fill: #ddd; }

  #shopify-section-{{ section.id }} .rm-platform-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  #shopify-section-{{ section.id }} .rm-platform-badge.google {
    background: #e8f0fe;
    color: #1a73e8;
  }

  #shopify-section-{{ section.id }} .rm-platform-badge.shopify {
    background: #e3f5e1;
    color: #008060;
  }

  #shopify-section-{{ section.id }} .rm-platform-badge.trustpilot {
    background: #e6f8f0;
    color: #00b67a;
  }

  #shopify-section-{{ section.id }} .rm-platform-badge.rm-platform-badge-custom {
    background: transparent;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .rm-platform-badge.rm-platform-badge-custom img {
    display: block;
    height: 20px;
    width: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .rm-review-text {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.65;
    color: var(--rm-text);
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .rm-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .rm-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--rm-accent), #667eea);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .rm-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .rm-avatar-initial {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .rm-author-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--rm-heading);
  }

  #shopify-section-{{ section.id }} .rm-author-info {
    font-size: 13px;
    color: var(--rm-text);
    opacity: 0.6;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .rm-author-info svg {
    width: 14px;
    height: 14px;
    fill: #22c55e;
  }

  /* Second row */
  #shopify-section-{{ section.id }} .rm-row-2 {
    margin-top: 25px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .rm-section {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .rm-title {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .rm-card {
      width: 300px;
      padding: 22px;
    }
    #shopify-section-{{ section.id }} .rm-marquee-wrapper::before,
    #shopify-section-{{ section.id }} .rm-marquee-wrapper::after {
      width: 50px;
    }
    #shopify-section-{{ section.id }} .rm-header {
      margin-bottom: 30px;
    }
  }
</style>

<div class="rm-section">
  <div class="rm-header">
    {% if section.settings.eyebrow != blank %}
    <div class="rm-eyebrow">
      <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {{ section.settings.eyebrow }}
    </div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="rm-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="rm-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <!-- Row 1 -->
  <div class="rm-marquee-wrapper">
