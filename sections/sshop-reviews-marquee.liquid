                {% else %}
                  <svg class="empty" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {% endif %}
              {% endfor %}
            </div>
            {% if block.settings.custom_logo != blank %}
            <span class="rm-platform-badge rm-platform-badge-custom"><img src="{{ block.settings.custom_logo | image_url: width: 80 }}" alt="" loading="lazy"></span>
            {% elsif block.settings.platform != 'none' %}
            <span class="rm-platform-badge {{ block.settings.platform }}">{{ block.settings.platform }}</span>
            {% endif %}
          </div>

          <p class="rm-review-text">{{ block.settings.text }}</p>

          <div class="rm-author">
            <div class="rm-avatar">
              {% if block.settings.avatar != blank %}
                <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% else %}
                <span class="rm-avatar-initial">{{ block.settings.name | slice: 0 }}</span>
              {% endif %}
            </div>
            <div>
              <div class="rm-author-name">{{ block.settings.name }}</div>
              <div class="rm-author-info">
                {% if block.settings.verified %}
                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                {% endif %}
                {{ block.settings.info }}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
      <!-- Duplicate for infinite scroll -->
      {% for block in section.blocks %}
        <div class="rm-card">
          <div class="rm-card-header">
            <div class="rm-stars">
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  <svg class="filled" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {% else %}
                  <svg class="empty" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {% endif %}
              {% endfor %}
            </div>
            {% if block.settings.custom_logo != blank %}
            <span class="rm-platform-badge rm-platform-badge-custom"><img src="{{ block.settings.custom_logo | image_url: width: 80 }}" alt="" loading="lazy"></span>
            {% elsif block.settings.platform != 'none' %}
            <span class="rm-platform-badge {{ block.settings.platform }}">{{ block.settings.platform }}</span>
            {% endif %}
          </div>
          <p class="rm-review-text">{{ block.settings.text }}</p>
          <div class="rm-author">
            <div class="rm-avatar">
              {% if block.settings.avatar != blank %}
                <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% else %}
                <span class="rm-avatar-initial">{{ block.settings.name | slice: 0 }}</span>
              {% endif %}
            </div>
            <div>
              <div class="rm-author-name">{{ block.settings.name }}</div>
              <div class="rm-author-info">
                {% if block.settings.verified %}
                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                {% endif %}
                {{ block.settings.info }}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if section.settings.show_second_row %}
